       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QCheckBox" name="checkSew">
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="toolTip">
         <string>Attempt to sew the resulting faces into a proper shell.
